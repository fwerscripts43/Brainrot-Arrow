-- ArrowConnector LocalScript
-- Place this inside StarterPlayerScripts or StarterCharacterScripts
-- Draws arrow beams from the player to any models in TARGET_NAMES
-- Also shows a floating label above each model with its name.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- Name → display info table
local TARGET_NAMES = {
	["Garama and Madundung"]    = { label = "Garama and Madundung" },
	["Dragon Cannelloni"]       = { label = "Dragon Cannelloni" },
	["Ketchuru and Musturu"]    = { label = "Ketchuru and Musturu" },
	["Burguro and Fryuro"]      = { label = "Burguro and Fryuro" },
	["Fragrama and Chocrama"]   = { label = "Fragrama and Chocrama" },
	["Hydra Dragon Cannelloni"] = { label = "Hydra Dragon Cannelloni" },
	["La Easter Grande"]        = { label = "La Easter Grande" },
	["La Lucky Grande"]         = { label = "La Lucky Grande" },
	["Dragon Gingerini"]        = { label = "Dragon Gingerini" },
	["Meowl"]                   = { label = "Meowl" },
	["Strawberry Elephant"]     = { label = "Strawberry Elephant" },
	["Skibidi Toilet"]          = { label = "Skibidi Toilet" },
}

-- Wait for character to load
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- Arrow beam texture (Roblox's built-in arrow texture ID)
local ARROW_TEXTURE = "rbxassetid://6868281828"

local activeBeams = {}

local function createAttachment(parent)
	local att = Instance.new("Attachment")
	att.Parent = parent
	return att
end

local function createBeam(fromAtt, toAtt, color)
	local beam = Instance.new("Beam")
	beam.Attachment0 = fromAtt
	beam.Attachment1 = toAtt
	beam.Texture = ARROW_TEXTURE
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureSpeed = 1.5
	beam.TextureLength = 3
	beam.Width0 = 0.4
	beam.Width1 = 0.4
	beam.Color = ColorSequence.new(color)
	beam.LightEmission = 0.6
	beam.LightInfluence = 0.4
	beam.FaceCamera = true
	beam.Segments = 1
	beam.CurveSize0 = 0
	beam.CurveSize1 = 0
	beam.Parent = hrp
	return beam
end

-- Each model gets a unique color based on its name
local MODEL_COLORS = {
	["Garama and Madundung"]    = Color3.fromRGB(255, 100, 50),   -- orange-red
	["Dragon Cannelloni"]       = Color3.fromRGB(80, 200, 255),   -- icy blue
	["Ketchuru and Musturu"]    = Color3.fromRGB(255, 60, 60),    -- red
	["Burguro and Fryuro"]      = Color3.fromRGB(255, 200, 50),   -- golden yellow
	["Fragrama and Chocrama"]   = Color3.fromRGB(180, 100, 255),  -- purple
	["Hydra Dragon Cannelloni"] = Color3.fromRGB(50, 255, 120),   -- green
	["La Easter Grande"]        = Color3.fromRGB(255, 160, 220),  -- pink
	["La Lucky Grande"]         = Color3.fromRGB(100, 255, 80),   -- lime
	["Dragon Gingerini"]        = Color3.fromRGB(255, 140, 0),    -- deep orange
	["Meowl"]                   = Color3.fromRGB(160, 220, 255),  -- light blue
	["Strawberry Elephant"]     = Color3.fromRGB(255, 80, 130),   -- strawberry pink
	["Skibidi Toilet"]          = Color3.fromRGB(200, 200, 200),  -- grey
}

local function getModelColor(name)
	return MODEL_COLORS[name] or Color3.fromRGB(255, 255, 255)
end

local function createLabel(targetRoot, info, color)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ModelLabel"
	billboard.Adornee = targetRoot
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.new(0, 220, 0, 45)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.ResetOnSpawn = false
	billboard.Parent = targetRoot

	-- Background frame
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
	frame.BackgroundTransparency = 0.25
	frame.BorderSizePixel = 0
	frame.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	-- Colored top accent bar
	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(1, 0, 0, 4)
	accent.Position = UDim2.new(0, 0, 0, 0)
	accent.BackgroundColor3 = color
	accent.BorderSizePixel = 0
	accent.Parent = frame

	local accentCorner = Instance.new("UICorner")
	accentCorner.CornerRadius = UDim.new(0, 8)
	accentCorner.Parent = accent

	-- Model name label
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -10, 1, -8)
	nameLabel.Position = UDim2.new(0, 5, 0, 8)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = info.label
	nameLabel.TextColor3 = color
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Parent = frame

	return billboard
end

local function getModelRoot(model)
	if model.PrimaryPart then return model.PrimaryPart end
	local hrpFound = model:FindFirstChild("HumanoidRootPart")
	if hrpFound then return hrpFound end
	return model:FindFirstChildWhichIsA("BasePart")
end

local function connectToModel(model)
	if activeBeams[model] then return end

	local targetRoot = getModelRoot(model)
	if not targetRoot then return end

	local info    = TARGET_NAMES[model.Name]
	local color   = getModelColor(model.Name)
	local fromAtt = createAttachment(hrp)
	local toAtt   = createAttachment(targetRoot)
	local beam    = createBeam(fromAtt, toAtt, color)
	local label   = createLabel(targetRoot, info, color)

	activeBeams[model] = {
		beam    = beam,
		fromAtt = fromAtt,
		toAtt   = toAtt,
		label   = label,
	}

	-- Clean up if the model is removed
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(game) then
			if activeBeams[model] then
				beam:Destroy()
				fromAtt:Destroy()
				toAtt:Destroy()
				label:Destroy()
				activeBeams[model] = nil
			end
		end
	end)
end

local function scanWorkspace()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and TARGET_NAMES[obj.Name] then
			connectToModel(obj)
		end
	end
end

-- Initial scan
scanWorkspace()

-- Watch for new models added during runtime
workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") and TARGET_NAMES[obj.Name] then
		task.wait()
		connectToModel(obj)
	end
end)

-- Respawn handling: reconnect beams if character respawns
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	hrp = newChar:WaitForChild("HumanoidRootPart")
	activeBeams = {}
	task.wait(1)
	scanWorkspace()
end)
