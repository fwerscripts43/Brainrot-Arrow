-- ArrowConnector LocalScript
-- Place this inside StarterPlayerScripts or StarterCharacterScripts
-- Draws arrow beams from the player to any models named:
--   "Garama and Madundung" or "Dragon Cannelloni"
-- Also shows a floating label above each model with its name and type.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

-- Name → display info table
local TARGET_NAMES = {
	["Garama and Madundung"] = { label = "Garama and Madundung" },
	["Dragon Cannelloni"]    = { label = "Dragon Cannelloni" },
  ["Ketchuru and Musturu"] = { label = "Ketchuru and Musturu" },
  ["Burguro and Fryuro"] = { label "Burguro and Fryuro" },
  ["Fragrama and Chocrama"] = { label "Fragrama and Chocrama" },
  ["Hydra Dragon Cannelloni"] = { label "Hydra Dragon Cannelloni" },
  ["La Easter Grande"] = { label "La Easter Grande" },
  ["La Lucky Grande"] = { label "La Lucky Grande" },
  ["Dragon Gingerini"] = { label "Dragon Gingerini" },
	["Meowl"] = { label "Meowl" },
	["Strawberry Elephant"] = { label "Strawberry Elephant" },
	["Skibidi Toilet"] = { label "Skikbidi Toilet" },
}

-- Wait for character to load
local character = player.Character or player.CharacterAdded:Wait()
local hrp = character:WaitForChild("HumanoidRootPart")

-- Arrow beam texture (Roblox's built-in arrow texture ID)
local ARROW_TEXTURE = "rbxassetid://6868281828"

local activeBeams = {}

local function createAttachment(parent)
	local att = Instance.new("Attachment")
	att.Parent = parent
	return att
end

local function createBeam(fromAtt, toAtt, color)
	local beam = Instance.new("Beam")
	beam.Attachment0 = fromAtt
	beam.Attachment1 = toAtt
	beam.Texture = ARROW_TEXTURE
	beam.TextureMode = Enum.TextureMode.Static
	beam.TextureSpeed = 1.5        -- animates the arrow moving forward
	beam.TextureLength = 3
	beam.Width0 = 0.4
	beam.Width1 = 0.4
	beam.Color = ColorSequence.new(color)
	beam.LightEmission = 0.6
	beam.LightInfluence = 0.4
	beam.FaceCamera = true
	beam.Segments = 1              -- straight line
	beam.CurveSize0 = 0
	beam.CurveSize1 = 0
	beam.Parent = hrp
	return beam
end

local function getModelColor(name)
	if name == "Garama and Madundung" then
		return Color3.fromRGB(255, 100, 50)   -- orange-red
	elseif name == "Dragon Cannelloni" then
		return Color3.fromRGB(80, 200, 255)   -- icy blue
	end
	return Color3.fromRGB(255, 255, 255)
end

local function createLabel(targetRoot, info, color)
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "ModelLabel"
	billboard.Adornee = targetRoot
	billboard.AlwaysOnTop = true
	billboard.Size = UDim2.new(0, 220, 0, 60)
	billboard.StudsOffset = Vector3.new(0, 4, 0)   -- floats above the model
	billboard.ResetOnSpawn = false
	billboard.Parent = targetRoot

	-- Background frame
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
	frame.BackgroundTransparency = 0.25
	frame.BorderSizePixel = 0
	frame.Parent = billboard

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = frame

	-- Colored top accent bar
	local accent = Instance.new("Frame")
	accent.Size = UDim2.new(1, 0, 0, 4)
	accent.Position = UDim2.new(0, 0, 0, 0)
	accent.BackgroundColor3 = color
	accent.BorderSizePixel = 0
	accent.Parent = frame

	local accentCorner = Instance.new("UICorner")
	accentCorner.CornerRadius = UDim.new(0, 8)
	accentCorner.Parent = accent

	-- Model name label
	local nameLabel = Instance.new("TextLabel")
	nameLabel.Size = UDim2.new(1, -10, 0, 28)
	nameLabel.Position = UDim2.new(0, 5, 0, 6)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Text = info.label
	nameLabel.TextColor3 = color
	nameLabel.TextScaled = true
	nameLabel.Font = Enum.Font.GothamBold
	nameLabel.TextXAlignment = Enum.TextXAlignment.Center
	nameLabel.Parent = frame

	-- Type subtitle label
	local typeLabel = Instance.new("TextLabel")
	typeLabel.Size = UDim2.new(1, -10, 0, 18)
	typeLabel.Position = UDim2.new(0, 5, 0, 36)
	typeLabel.BackgroundTransparency = 1
	typeLabel.Text = "[ " .. info.type .. " ]"
	typeLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
	typeLabel.TextScaled = true
	typeLabel.Font = Enum.Font.Gotham
	typeLabel.TextXAlignment = Enum.TextXAlignment.Center
	typeLabel.Parent = frame

	return billboard
end

local function getModelRoot(model)
	-- Try PrimaryPart first, then HumanoidRootPart, then any BasePart
	if model.PrimaryPart then return model.PrimaryPart end
	local hrpFound = model:FindFirstChild("HumanoidRootPart")
	if hrpFound then return hrpFound end
	return model:FindFirstChildWhichIsA("BasePart")
end

local function connectToModel(model)
	if activeBeams[model] then return end  -- already connected

	local targetRoot = getModelRoot(model)
	if not targetRoot then return end

	local info  = TARGET_NAMES[model.Name]
	local color = getModelColor(model.Name)
	local fromAtt = createAttachment(hrp)
	local toAtt   = createAttachment(targetRoot)
	local beam    = createBeam(fromAtt, toAtt, color)
	local label   = createLabel(targetRoot, info, color)

	activeBeams[model] = {
		beam    = beam,
		fromAtt = fromAtt,
		toAtt   = toAtt,
		label   = label,
	}

	-- Clean up if the model is removed
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(game) then
			if activeBeams[model] then
				beam:Destroy()
				fromAtt:Destroy()
				toAtt:Destroy()
				label:Destroy()
				activeBeams[model] = nil
			end
		end
	end)
end

local function scanWorkspace()
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and TARGET_NAMES[obj.Name] then
			connectToModel(obj)
		end
	end
end

-- Initial scan
scanWorkspace()

-- Watch for new models added during runtime
workspace.DescendantAdded:Connect(function(obj)
	if obj:IsA("Model") and TARGET_NAMES[obj.Name] then
		task.wait()  -- small wait so model can finish loading
		connectToModel(obj)
	end
end)


-- Respawn handling: reconnect beams if character respawns
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	hrp = newChar:WaitForChild("HumanoidRootPart")
	activeBeams = {}
	task.wait(1)
	scanWorkspace()
end)
